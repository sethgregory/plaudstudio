{
  "name": "plaud-studio",
  "productName": "Plaud Studio",
  "version": "1.0.0",
  "description": "Plaud Note & Lecture Summarizer Desktop Studio",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/brand-dev-electron.cjs && electron .",
    "app": "node scripts/brand-dev-electron.cjs && electron .",
    "postinstall": "node scripts/brand-dev-electron.cjs",
    "build:icon": "electron scripts/generate-icon.cjs",
    "package:mac": "electron-builder --mac --arm64 --dir",
    "dist:mac": "electron-builder --mac --arm64",
    "install:app": "npm run package:mac && rm -rf \"/Applications/Plaud Studio.app\" && cp -R \"dist/mac-arm64/Plaud Studio.app\" \"/Applications/Plaud Studio.app\""
  },
  "build": {
    "appId": "com.plaudstudio.desktop",
    "productName": "Plaud Studio",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleName": "Plaud Studio",
        "CFBundleDisplayName": "Plaud Studio",
        "CFBundleExecutable": "Plaud Studio",
        "NSMicrophoneUsageDescription": "Plaud Studio uses microphone for voice transcription and audio recording.",
        "NSSupportsAutomaticGraphicsSwitching": true
      }
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "src/diarize.py"
    ]
  },
  "dependencies": {
    "@plaud-ai/mcp": "^0.3.14",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  }
}
